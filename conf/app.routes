# microservice specific routes

->          /hmrc-frontend                                     hmrcfrontend.Routes

GET         /assets/*file                                      controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                                    controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                                   controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                                controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /account/sign-out-survey                           controllers.auth.AuthController.signOut()
GET         /account/sign-out                                  controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                                controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                      controllers.UnauthorisedController.onPageLoad()

GET         /                                                  controllers.IndexController.onPageLoad()
POST        /                                                  controllers.IndexController.submit()

GET         /confirmation                             controllers.RegistrationCompleteController.onPageLoad
GET         /registering                          controllers.RegistrationRegisteringController.onPageLoad(idempotencyKey: String)

GET         /business-match                                    controllers.GrsController.start()
GET         /business-match/result                             controllers.GrsController.callBack(journeyId: String)

GET         /contact-details                                   controllers.ContactDetailsGuidanceController.onPageLoad()
POST        /contact-details                                   controllers.ContactDetailsGuidanceController.continue()

GET         /contact-details/first/full-name                        controllers.ContactNameController.onPageLoad(contactType: ContactType = ContactType.First, mode: Mode ?= NormalMode)
POST        /contact-details/first/full-name                        controllers.ContactNameController.onSubmit(contactType: ContactType = ContactType.First, mode: Mode)

GET         /contact-details/second/full-name                       controllers.ContactNameController.onPageLoad(contactType: ContactType = ContactType.Second, mode: Mode ?= NormalMode)
POST        /contact-details/second/full-name                       controllers.ContactNameController.onSubmit(contactType: ContactType = ContactType.Second, mode: Mode)

GET         /contact-details/first/email-address                       controllers.ContactEmailController.onPageLoad(contactType: ContactType = ContactType.First, mode: Mode ?= NormalMode)
POST        /contact-details/first/email-address                       controllers.ContactEmailController.onSubmit(contactType: ContactType = ContactType.First, mode: Mode)

GET         /contact-details/second/email-address                      controllers.ContactEmailController.onPageLoad(contactType: ContactType = ContactType.Second, mode: Mode ?= NormalMode)
POST        /contact-details/second/email-address                      controllers.ContactEmailController.onSubmit(contactType: ContactType = ContactType.Second, mode: Mode)

GET         /contact-details/first/add-second                 controllers.ContactHaveYouAddedAllController.onPageLoad(contactType: ContactType = ContactType.First, mode: Mode ?= NormalMode)
POST        /contact-details/first/add-second                 controllers.ContactHaveYouAddedAllController.onSubmit(contactType: ContactType = ContactType.First, mode: Mode)

GET         /contact-details/second/add-another                controllers.ContactHaveYouAddedAllController.onPageLoad(contactType: ContactType = ContactType.Second, mode: Mode ?= NormalMode)
POST        /contact-details/second/add-another                controllers.ContactHaveYouAddedAllController.onSubmit(contactType: ContactType = ContactType.Second, mode: Mode)

GET         /contact-details/first/check-answers          controllers.ContactCheckYourAnswersController.onPageLoadLegacy(contactType: ContactType = ContactType.First)
POST        /contact-details/first/check-answers          controllers.ContactCheckYourAnswersController.saveAndContinueLegacy(contactType: ContactType = ContactType.First)

GET         /contact-details/second/check-answers         controllers.ContactCheckYourAnswersController.onPageLoadLegacy(contactType: ContactType = ContactType.Second)
POST        /contact-details/second/check-answers         controllers.ContactCheckYourAnswersController.saveAndContinueLegacy(contactType: ContactType = ContactType.Second)

GET         /contact-details/check-answers                controllers.ContactCheckYourAnswersController.onPageLoadReshuffled()
POST        /contact-details/check-answers                controllers.ContactCheckYourAnswersController.saveAndContinueReshuffled()

GET        /start-registration                 controllers.NominatedCompanyDetailsGuidanceController.onPageLoad()
POST       /start-registration                 controllers.NominatedCompanyDetailsGuidanceController.onSubmit()

GET        /cannot-access-service                             controllers.CannotAccessServiceController.onPageLoad()

GET        /agent-cannot-access-service                       controllers.AgentCannotAccessServiceController.onPageLoad()

GET        /already-registered                                controllers.AlreadyRegisteredController.onPageLoad()

GET        /standard-user-cannot-access-service                   controllers.StandardUserCannotAccessServiceController.onPageLoad()
