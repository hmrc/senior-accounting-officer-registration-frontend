nominatedCompanyDetailsGuidance.title = Nodwch fanylion cyswllt eich cwmni enwebedig
nominatedCompanyDetailsGuidance.heading = Beth sydd ei angen arnoch i ddechrau’ch cofrestriad
nominatedCompanyDetailsGuidance.caption = Manylion y cwmni enwebedig
nominatedCompanyDetailsGuidance.paragraph1 = Mae’n rhaid i’r manylion canlynol fod gennych er mwyn parhau. Byddwn ni’n eu defnyddio i gadarnau’ch cwmni enwebedig.
nominatedCompanyDetailsGuidance.paragraph2 = Bydd angen i chi roi’r canlynol:
nominatedCompanyDetailsGuidance.bulletPoint1 = Rhif Cofrestru’r cwmni (CRN)
nominatedCompanyDetailsGuidance.bulletPoint2 = Cyfeirnod Unigryw y Trethdalwr (UTR)
nominatedCompanyDetailsGuidance.paragraph3 = Mae’n rhaid i’r manylion a nodwch gyfateb i gofnodion Tŷ’r Cwmnïau. Os nad ydyn nhw’n cyfateb, ni allwch chi gwblhau’ch cofrestriad.

nominatedCompanyDetailsGuidance.paragraph4 = Os nad oes CRN gan eich cwmni enwebedig, ewch ati i gofrestru gan ddefnyddio cwmni arall yn eich sefydliad sydd ag un.
nominatedCompanyDetailsGuidance.paragraph5 = Os nad oes CRN gan unrhyw gwmni yn eich sefydliad, cysylltwch â’ch Rheolwr Cydymffurfiad Cwsmeriaid, os oes gennych un neu e-bostiwch {0} am gymorth.
nominatedCompanyDetailsGuidance.email = wmbc.saomailbox@hmrc.gov.uk

cannotAccessService.title = You cannot access this service
cannotAccessService.heading = You cannot access this service
cannotAccessService.individual.paragraph1 = You’ve signed in with an individual account. Only administrators of an organisation account can register to use this service.
cannotAccessService.individual.paragraph2 = If you still need to register, {0}
cannotAccessService.individual.signIn.linkText = sign in to Government Gateway with an organisation account
cannotAccessService.findOutMore.linkText = Find out more about who can use this service

agentCannotAccessService.paragraph1 = You’ve signed in using an agent services Government Gateway user ID. Agents must not register or use the Senior Accounting Officer notification and certificate service.
agentCannotAccessService.paragraph2 = Only authorised members in a company with an organisation account can register to use this service.

alreadyRegistered.title = Your company has already registered for this service
alreadyRegistered.heading = Your company has already registered for this service
alreadyRegistered.paragraph1 = You’ll need to do one of the following to access the service:
alreadyRegistered.bulletPoint1 = use the registration details already created to log in
alreadyRegistered.bulletPoint2 = register a different nominated company
alreadyRegistered.paragraph2 = You can find a link to the Senior Accounting Officer notification and certificate service in the associated HMRC {0}.
alreadyRegistered.businessTaxAccount.linkText = business tax account (opens in new tab)
alreadyRegistered.paragraph3 = From there you can make a submission.
alreadyRegistered.paragraph4 = Log in using your organisation Government Gateway ID.

standardUserCannotAccessService.title = You cannot access this service
standardUserCannotAccessService.heading = You cannot access this service
standardUserCannotAccessService.paragraph1 = You’ve signed in using your organisation Government Gateway ID as an assistant with a standard user role. Only users with an administrator role can use this service.
standardUserCannotAccessService.paragraph2 = If you need to register, {0} that has the administrator role, or ask an administrator to add you as a team member with the administrator role
standardUserCannotAccessService.signIn.linkText = sign in using an organisation Government Gateway ID

pageNotFound.title = Error: Page not found
pageNotFound.heading = Page not found
pageNotFound.paragraph1 = If you typed the web address, check it is correct.
pageNotFound.paragraph2 = If you pasted the web address, check you copied the entire address.
pageNotFound.paragraph3WithLink = If the web address is correct or you selected a link or button, contact your Customer Compliance Manager (CCM) if you have one, or email <a href="mailto:wmbc.saomailbox@hmrc.gov.uk" class="govuk-link">wmbc.saomailbox@hmrc.gov.uk</a> for support.

unexpectedError.title = Error: Sorry, there is a problem with the service
unexpectedError.heading = Sorry, there is a problem with the service
unexpectedError.paragraph1 = Try again later.
unexpectedError.paragraph2WithLink = Contact your Customer Compliance Manager (CCM) if you have one, or email <a href="mailto:wmbc.saomailbox@hmrc.gov.uk" class="govuk-link">wmbc.saomailbox@hmrc.gov.uk</a> for support.

